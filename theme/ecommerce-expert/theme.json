	"styles": {
		"color": {
			"background": "var:preset|color|paper",
			"text": "var:preset|color|ink"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|schibsted-grotesk",
			"fontSize": "var:preset|font-size|16",
			"fontWeight": "400",
			"lineHeight": "1.55",
			"letterSpacing": "normal"
		},
		"spacing": {
			"blockGap": "0px",
			"padding": {
				"left": "0",
				"right": "0",
				"top": "0",
				"bottom": "0"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|ink"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|muted"
					}
				},
				":focus": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"heading": {
				"color": {
					"text": "inherit"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|schibsted-grotesk",
					"fontWeight": "700",
					"lineHeight": "1.2",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|76",
					"lineHeight": "1.02",
					"letterSpacing": "-0.035em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|52",
					"lineHeight": "1.05",
					"letterSpacing": "-0.03em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|22",
					"lineHeight": "1.55",
					"letterSpacing": "-0.01em"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|ink",
					"text": "var:preset|color|paper"
				},
				"border": {
					"color": "var:preset|color|ink",
					"width": "1px",
					"style": "solid",
					"radius": "2px"
				},
				"spacing": {
					"padding": {
						"top": "0",
						"bottom": "0",
						"left": "24px",
						"right": "24px"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|schibsted-grotesk",
					"fontSize": "var:preset|font-size|15",
					"fontWeight": "600",
					"lineHeight": "1.55",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|dark-line",
						"text": "var:preset|color|paper"
					},
					"border": {
						"color": "var:preset|color|dark-line"
					},
					"typography": {
						"textDecoration": "none"
					}
				},
				":focus": {
					"color": {
						"background": "var:preset|color|dark-line",
						"text": "var:preset|color|paper"
					}
				},
				":active": {
					"color": {
						"background": "var:preset|color|dark-line",
						"text": "var:preset|color|paper"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": "2px"
				},
				"spacing": {
					"padding": {
						"top": "0",
						"bottom": "0",
						"left": "24px",
						"right": "24px"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|15",
					"fontWeight": "600"
				}
			},
			"core/list": {
				"spacing": {
					"padding": {
						"left": "18px"
					}
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var:preset|font-size|15"
				}
			}
