# Kopieren nach .env (wird nicht versioniert): cp .env.example .env
COMPOSE_PROJECT_NAME=ecommerce-expert

# Datenbank (DB_IMAGE_TAG: Standard 11; lokal z. B. "lts", wenn mariadb:11 nicht verfügbar ist)
# DB_IMAGE_TAG=11
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me-db
DB_ROOT_PASSWORD=change-me-root

# WordPress (lokale Entwicklung)
WP_PORT=8080
WP_URL=http://localhost:8080
WP_TITLE="ecommerce-expert.de"
WP_TAGLINE="Online-Shops, die verkaufen. Technik, die trägt."
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me-admin
WP_ADMIN_EMAIL=admin@example.com

# Kontaktformular und Mailversand (per SMTP über mu-plugins/ecommerce-expert-mail.php; kein mail())
# Lokal fängt Mailpit alle Mails ab (http://localhost:8025). Für Staging/Live echte SMTP-Zugangsdaten eintragen.
CONTACT_MAIL_TO=kontakt@ecommerce-expert.de
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=kontakt@ecommerce-expert.de
MAILPIT_PORT=8025
