# Auf dem VPS nach deploy/.env kopieren und ausfüllen (wird nicht versioniert).
# WICHTIG: Werte mit "$" (BASIC_AUTH_HASH) in EINFACHE Anführungszeichen setzen.

# --- Domain / TLS ---
SITE_DOMAIN=staging.ecommerce-expert.de
ACME_EMAIL=info@example.com
WP_ENVIRONMENT_TYPE=staging

# --- Staging-Schutz (Basic Auth) ---
# Hash erzeugen: docker run --rm caddy:2 caddy hash-password --plaintext 'GEHEIMES-PASSWORT'
BASIC_AUTH_USER=staging
BASIC_AUTH_HASH='$2a$14$hier-den-bcrypt-hash-eintragen'

# --- Caddy-Konfiguration: Standard ist Staging. Live NUR nach ausdrücklicher Freigabe ---
CADDYFILE=./Caddyfile.staging
# CADDYFILE=./Caddyfile.live

# --- Datenbank ---
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=bitte-sicheres-passwort
DB_ROOT_PASSWORD=bitte-anderes-sicheres-passwort

# --- WordPress-Einrichtung (scripts/setup.sh) ---
WP_URL=https://staging.ecommerce-expert.de
WP_TITLE="ecommerce-expert.de (Staging)"
WP_TAGLINE="Online-Shops, die verkaufen. Technik, die trägt."
WP_ADMIN_USER=bitte-aendern
WP_ADMIN_PASSWORD=bitte-sicheres-passwort
WP_ADMIN_EMAIL=info@example.com
# Auf dem Server kein Create Block Theme (Theme ist read-only, Änderungen laufen über Git)
SETUP_DEV_PLUGINS=0

# --- Mailversand (SMTP, siehe README „Mailversand“) ---
CONTACT_MAIL_TO=kontakt@ecommerce-expert.de
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=kontakt@ecommerce-expert.de
